{
    "version": "2.0.0",
    "options": {
        "shell": {
            "executable": "powershell.exe",
            "args": [
                "-ExecutionPolicy",
                "Bypass",
                "-Command"
            ]
        }
    },
    "tasks": [
        {
            "label": "1. Build TEF",
            "type": "shell",
            "command": "& 'C:\\Espressif\\tools\\Microsoft.v5.5.3.PowerShell_profile.ps1' ; idf.py build",
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "2. Flash & Monitor COM3",
            "type": "shell",
            "command": "& 'C:\\Espressif\\tools\\Microsoft.v5.5.3.PowerShell_profile.ps1' ; idf.py -p COM3 flash monitor",
            "dependsOn": "1. Build TEF",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "3. Flash & Monitor COM4",
            "type": "shell",
            "command": "& 'C:\\Espressif\\tools\\Microsoft.v5.5.3.PowerShell_profile.ps1' ; idf.py -p COM4 flash monitor",
            "dependsOn": "1. Build TEF",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Deploy TEF (COM3 & COM4)",
            "dependsOn": [
                "2. Flash & Monitor COM3",
                "3. Flash & Monitor COM4"
            ],
            "dependsOrder": "parallel",
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}